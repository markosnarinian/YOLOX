#!/usr/bin/env bash
set -euo pipefail

log_step() {
    printf '\n==> %s\n' "$1"
}

ensure_system_packages() {
    local packages=(build-essential cmake python3-dev)
    local missing=()
    local package

    for package in "${packages[@]}"; do
        if ! dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null | grep -qx installed; then
            missing+=("$package")
        fi
    done

    if ((${#missing[@]})); then
        log_step "Installing system build dependencies: ${missing[*]}"
        sudo -n apt-get update
        sudo -n apt-get install -y --no-install-recommends "${missing[@]}"
    else
        log_step "System build dependencies are already installed"
    fi
}

log_step "Preparing the YOLOX orb environment"
ensure_system_packages

log_step "Installing Python packaging tools"
python3 -m pip install --upgrade pip setuptools wheel

log_step "Installing YOLOX runtime and development dependencies"
python3 -m pip install -r requirements.txt
python3 -m pip install onnxruntime
python3 -m pip install --no-build-isolation -e .
python3 -m pip install isort==4.3.21 flake8==3.8.3 'importlib-metadata<5.0'

log_step "Verifying the installed package"
python3 - <<'PY'
import torch
import yolox

print(f"torch {torch.__version__}")
print(f"yolox {yolox.__version__}")
PY
