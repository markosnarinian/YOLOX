#!/usr/bin/env bash
set -euo pipefail

log_step() {
    printf '\n==> %s\n' "$1"
}

ensure_system_packages() {
    local packages=(build-essential cmake libgl1 libglib2.0-0)
    local missing=()
    local package

    for package in "${packages[@]}"; do
        if ! dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null | grep -qx installed; then
            missing+=("$package")
        fi
    done

    if ((${#missing[@]})); then
        log_step "Installing system build dependencies: ${missing[*]}"
        sudo -n apt-get update
        sudo -n apt-get install -y --no-install-recommends "${missing[@]}"
    else
        log_step "System build dependencies are already installed"
    fi
}

log_step "Preparing the YOLOX orb environment"
ensure_system_packages

log_step "Checking uv (provided by the orb toolchain)"
command -v uv >/dev/null || {
    printf 'uv is required; install it before running this setup.\n' >&2
    exit 1
}
uv --version

log_step "Syncing locked CPU, export, development and documentation dependencies"
time uv sync --locked --extra cpu --extra export --group docs

log_step "Verifying the installed package"
time uv run --no-sync python - <<'PY'
import torch
import yolox
from yolox.models import yolox_nano

print(f"torch {torch.__version__}")
print(f"yolox {yolox.__version__}")
with torch.no_grad():
    output = yolox_nano(pretrained=False, device="cpu").eval()(torch.zeros(1, 3, 64, 64))
assert output.shape == (1, 84, 85) and torch.isfinite(output).all()
print("CPU Nano inference passed")
PY
